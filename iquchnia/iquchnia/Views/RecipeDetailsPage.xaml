<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:iquchnia.ViewModels"
    x:Class="iquchnia.Views.RecipeDetailsPage"
    x:DataType="vm:RecipeDetailsViewModel"
    Title="{Binding Recipe.Name}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="10">
            <Label Text="{Binding Recipe.Name}" FontSize="24" FontAttributes="Bold"/>

            <Label Text="Składniki:" FontAttributes="Bold"/>
            <Label Text="{Binding IngredientsString}" />

            <Label Text="Instrukcje:" FontAttributes="Bold"/>
            <Label Text="{Binding Recipe.Description}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>