<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:iquchnia.ViewModels"
    x:Class="iquchnia.Views.RecipeDetailsPage"
    x:DataType="vm:RecipeDetailsViewModel"
    Title="{Binding Recipe.Name}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F5F5">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <Label Text="{Binding Recipe.Name}"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#333333" />

            <HorizontalStackLayout Spacing="20">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="🕒" />
                    <Label Text="{Binding Recipe.CzasPrzygotowaniaMin, StringFormat='{0} min'}"
               FontAttributes="Bold" TextColor="Black"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5">
                    <Label Text="📊" />
                    <Label Text="{Binding Recipe.PoziomTrudnosci}"
               FontAttributes="Bold" TextColor="Black" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5">
                    <Label Text="⚖️" />
                    <Label Text="{Binding Recipe.Ilosc}" 
               FontAttributes="Bold" TextColor="Black" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="#D3D3D3" Margin="0,10" />

            <Label Text="Składniki"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#E64A19" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recipe.Ingredients}"
                                 Spacing="5"
                                 Margin="10,5,0,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="•" FontSize="18" TextColor="#E64A19" VerticalOptions="Center"/>
                            <Label Text="{Binding .}" FontSize="16" TextColor="Black" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#D3D3D3" Margin="0,10" />

            <Label Text="Sposób przygotowania"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#E64A19" />

            <Label Text="{Binding Recipe.Description}"
                   FontSize="16"
                   LineHeight="1.2"
                   TextColor="#444444" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>