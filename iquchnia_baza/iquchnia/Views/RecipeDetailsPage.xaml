<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:iquchnia.ViewModels"
    x:Class="iquchnia.Views.RecipeDetailsPage"
    x:DataType="vm:RecipeDetailsViewModel"
    Title="{Binding Recipe.Name}"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F5F5">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Frame HasShadow="True" 
       Padding="0" 
       CornerRadius="15" 
       IsClippedToBounds="True"
       HeightRequest="250">
                <Grid>
                    <Label Text="Brak zdjęcia" 
               HorizontalOptions="Center" 
               VerticalOptions="Center" 
               TextColor="Gray" />

                    <Image Source="{Binding Recipe.ImageSource}"
               Aspect="AspectFill"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand" />
                </Grid>
            </Frame>

            <Label Text="{Binding Recipe.Name}"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   LineBreakMode="WordWrap" />

            <HorizontalStackLayout Spacing="20" Margin="0,5,0,0">
                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="🕒" VerticalOptions="Center" />
                    <Label Text="{Binding Recipe.CzasPrzygotowaniaMin, StringFormat='{0} min'}"
                           FontAttributes="Bold" TextColor="Black" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                    <Label Text="📊" VerticalOptions="Center" />
                    <Label Text="{Binding Recipe.PoziomTrudnosci}"
                           FontAttributes="Bold" TextColor="Black" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" Margin="0,5,0,5">
                <Label Grid.Column="0" Text="⚖️" FontSize="16" VerticalOptions="Start" Margin="0,1,0,0" />
                <Label Grid.Column="1" 
                       Text="{Binding Recipe.Ilosc}" 
                       FontAttributes="Bold" 
                       TextColor="Black" 
                       FontSize="14"
                       LineBreakMode="WordWrap" 
                       VerticalOptions="Start" />
            </Grid>

            <BoxView HeightRequest="1" Color="#D3D3D3" Margin="0,5" />

            <Label Text="Składniki"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#E64A19" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recipe.Ingredients}"
                                 Spacing="5"
                                 Margin="10,5,0,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" Margin="0,2">
                            <Label Grid.Column="0" Text="•" FontSize="18" TextColor="#E64A19" VerticalOptions="Start"/>
                            <Label Grid.Column="1" Text="{Binding .}" FontSize="16" TextColor="Black" LineBreakMode="WordWrap" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#D3D3D3" Margin="0,10" />

            <Label Text="Sposób przygotowania"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#E64A19" />

            <Label Text="{Binding Recipe.Description}"
                   FontSize="16"
                   LineHeight="1.2"
                   TextColor="#444444"
                   LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>